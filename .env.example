# Token usado APENAS para autenticar os heartbeats enviados pelo AikoBot.
MONITOR_TOKEN=troque-por-um-token-longo-e-aleatorio

# Token do bot Discord que será usado para enviar mensagens de status.
DISCORD_BOT_TOKEN=seu-token-do-aikobot

# ID do canal onde as mensagens de queda/retorno serão enviadas.
STATUS_CHANNEL_ID=123456789012345678

# Intervalo entre verificações do monitor.
CHECK_INTERVAL=30

# Tempo sem heartbeat necessário para considerar o AikoBot offline.
OFFLINE_AFTER=90

# Banco local do monitor.
DB_PATH=data/monitor.db
